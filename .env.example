# ============================================
# Supabase 配置（必需）
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only. Used by docker-compose db-migrate to apply SQL migrations.
# For Docker on IPv4-only networks, prefer the Supabase Session Pooler URL.
# Do not prefix this with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.your-project-ref:your_database_password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# ============================================
# 应用配置（必需）
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# ============================================
# 存储配置
# ============================================
# 存储模式：supabase | minio | hybrid
# - supabase: 仅使用 Supabase Storage（默认，推荐小项目）
# - minio: 仅使用 MinIO（自托管，大文件）
# - hybrid: 混合模式（Supabase DB + MinIO 文件，推荐生产）
NEXT_PUBLIC_STORAGE_TYPE=supabase

# ============================================
# MinIO 配置（仅在 storage_type=minio 或 hybrid 时需要）
# ============================================
# 连接配置
NEXT_PUBLIC_MINIO_ENDPOINT=minio
NEXT_PUBLIC_MINIO_PORT=9000
NEXT_PUBLIC_MINIO_USE_SSL=false
NEXT_PUBLIC_MINIO_PUBLIC_ENDPOINT=localhost
NEXT_PUBLIC_MINIO_PUBLIC_PORT=9000
NEXT_PUBLIC_MINIO_PUBLIC_USE_SSL=false
NEXT_PUBLIC_MINIO_BUCKET=aeon-photos

# 认证配置（⚠️ 生产环境必须修改）
NEXT_PUBLIC_MINIO_ACCESS_KEY=minioadmin
NEXT_PUBLIC_MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
