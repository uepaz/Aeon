# Supabase Configuration
# 获取方式：Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ⚠️ Service Role Key - 仅在服务端使用，拥有完全权限，切勿泄露
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database Connection
# 获取方式：Supabase Dashboard → Settings → Database → Connection String
# 注意：使用 Transaction 模式（prepared statements 已禁用）
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Storage Configuration
# ============================================
# 存储模式选择：supabase | minio | hybrid
# - supabase: 仅使用 Supabase Storage（默认，推荐小项目）
# - minio: 仅使用 MinIO（自托管，大文件）
# - hybrid: 混合模式（Supabase DB + MinIO 文件存储）
NEXT_PUBLIC_STORAGE_TYPE=supabase

# ============================================
# MinIO Configuration (仅在 storage_type=minio 或 hybrid 时需要)
# ============================================
# MinIO 连接配置
NEXT_PUBLIC_MINIO_ENDPOINT=localhost
NEXT_PUBLIC_MINIO_PORT=9000
NEXT_PUBLIC_MINIO_USE_SSL=false

# MinIO 认证（生产环境必须修改！）
NEXT_PUBLIC_MINIO_ACCESS_KEY=minioadmin
NEXT_PUBLIC_MINIO_SECRET_KEY=minioadmin

# MinIO 管理员账号（用于 Docker 容器）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MinIO 桶名称
NEXT_PUBLIC_MINIO_BUCKET=aeon-photos

# MinIO Console URL（Web 管理界面）
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# ============================================
# Optional: 生产环境额外配置
# ============================================
# NODE_ENV=production
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
